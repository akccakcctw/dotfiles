[General]
frontend=widgetsboxmodel-ng
{{- if eq .chezmoi.os "darwin" }}
hotkey=Alt+A
{{- end }}
{{- if eq .chezmoi.os "linux" }}
hotkey=Ctrl+Space
{{- end }}
prioritizePerfectMatch=true
showTray=true
telemetry=true
{{- if eq .chezmoi.os "darwin" }}
terminal=warp
{{- end }}
{{- if eq .chezmoi.os "linux" }}
terminal=Tilix
{{- end }}

[albert]
global_handler_enabled=true

[applications]
enabled=true
{{- if eq .chezmoi.os "linux" }}
terminal=com.gexperts.tilix
{{- end }}

[arch_wiki]
enabled=true

[bitwarden]
enabled=false

[calculator]
enabled=true

[calculator_qalculate]
enabled=true
global_handler_enabled=true

[chromium]
{{- if eq .chezmoi.os "linux" }}
bookmarks_path={{ .chezmoi.homeDir }}/.config/google-chrome/Default/Bookmarks, {{ .chezmoi.homeDir }}/.config/google-chrome/Guest Profile/Bookmarks, {{ .chezmoi.homeDir }}/.config/google-chrome/Profile 1/Bookmarks, {{ .chezmoi.homeDir }}/.config/google-chrome/Profile 2/Bookmarks, {{ .chezmoi.homeDir }}/.config/google-chrome/Profile 3/Bookmarks
{{- end }}
enabled=true
{{- if eq .chezmoi.os "linux" }}
profile_path={{ .chezmoi.homeDir }}/.config/chromium/Default
{{- end }}

[clipboard]
enabled=true

[color]
enabled=true

[copyq]
enabled=false

[dice_roll]
enabled=false

[emoji]
enabled=true

[goldendict]
enabled=false

[googletrans]
enabled=false

[hash]
enabled=true
global_handler_enabled=true

[mpris]
enabled=false

[python]
enabled=true
watchSources=false

[python.emoji]
enabled=true

[python_eval]
enabled=false

[qmlboxmodel]
displaySystemShadow=false

[snippets]
enabled=true

[timer]
enabled=true

[websearch]
enabled=true

[widgetsboxmodel]
action_item_padding=6
action_item_selection_border_radius=11
action_item_selection_border_width=0
alwaysOnTop=true
clearOnHide=false
clientShadow=true
darkTheme=Default System Palette
disable_input_method=true
displayIcons=true
displayScrollbar=false
followCursor=true
hideOnFocusLoss=true
historySearch=true
input_border_radius=11
input_font_size=20
input_padding=5
itemCount=5
lightTheme=Default System Palette
quitOnClose=false
result_item_horizontal_spacing=6
result_item_icon_size=39
result_item_padding=6
result_item_selection_border_radius=11
result_item_selection_border_width=0
result_item_subtext_font_size=10
result_item_text_font_size=15
result_item_vertical_spacing=2
showCentered=true
showFallbacksOnEmpty=true
systemShadow=true
theme=DarkOrange
window_border_radius=18
window_border_width=1
window_padding=7
window_shadow_offset=8
window_shadow_size=80
window_spacing=7
window_width=640

[widgetsboxmodel-ng]
alwaysOnTop=true
clearOnHide=true
displayScrollbar=false
followCursor=true
hideOnFocusLoss=true
historySearch=true
itemCount=5
quitOnClose=false
showCentered=true
